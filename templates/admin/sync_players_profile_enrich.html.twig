{% extends 'base.html.twig' %}

{% block title %}Enrichissement profils joueurs · Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin-sync-profile-enrich.css') }}?v=1">
    <link rel="stylesheet" href="{{ asset('css/admin-qa-checklist.css') }}?v=3">
{% endblock %}

{% block body %}
    <section class="ta-topbar admin-profile-enrich-topbar">
        <div>
            <h1 class="ta-page-title">
                <i class="ti ti-id" aria-hidden="true"></i>
                Enrichissement profils joueurs
            </h1>
            <p class="ta-page-subtitle">
                Complète les <strong>prénoms</strong> (et noms) via l’API <code>/players?id=</code>, pays par pays
                ({{ max_calls_per_batch }} appels API max par requête).
                Les joueurs déjà enrichis sont ignorés. En prod : <strong>1 pays par lot</strong>.
            </p>
        </div>
        <div class="admin-profile-enrich-topbar__actions">
            <a href="{{ path('admin') }}" class="btn btn-outline btn-sm">
                <i class="ti ti-settings" aria-hidden="true"></i>
                EasyAdmin
            </a>
        </div>
    </section>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash--{{ label }}" role="status">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% set progress_pct = status.countries_total > 0 ? ((status.countries_done / status.countries_total) * 100)|round : 0 %}

    <section class="ta-card" aria-labelledby="admin-profile-enrich-progress-title">
        <h2 id="admin-profile-enrich-progress-title" class="ta-card-title">Parcours en cours</h2>
        <p class="ta-card-text">
            Progression :
            <strong>{{ status.countries_done }} / {{ status.countries_total }}</strong>
            {% if status.completed %}
                (terminé)
            {% elseif not status.active %}
                (non démarré — cliquez sur Démarrer)
            {% endif %}
        </p>
        {% if status.active %}
            <div class="admin-qa-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress_pct }}">
                <span class="admin-qa-progress-bar__fill" style="width: {{ progress_pct }}%"></span>
            </div>
        {% endif %}
        <p class="ta-card-text" style="margin-top: 0.75rem;">
            Cumul : {{ status.totals.updated }} mis à jour,
            {{ status.totals.skipped }} ignorés,
            {{ status.totals.errors }} erreurs,
            {{ status.totals.api_calls }} appels API.
        </p>
        {% if status.next_country_names is not empty and not status.completed %}
            <p class="ta-card-text">
                Prochain lot : <strong>{{ status.next_country_names|join(', ') }}</strong>
            </p>
        {% endif %}
    </section>

    <div class="admin-profile-enrich-grid">
        <section class="ta-card admin-profile-enrich-country-card--ok" aria-labelledby="admin-profile-enrich-synced-title">
            <h2 id="admin-profile-enrich-synced-title" class="admin-profile-enrich-country-card__title admin-profile-enrich-country-card__title--ok">
                Pays synchronisés ({{ overview.synced|length }})
            </h2>
            <p class="ta-card-text">Tous les joueurs API ont un prénom complet.</p>
            {% if overview.synced is empty %}
                <p class="ta-card-text">Aucun pays pour l’instant (ou effectifs non importés).</p>
            {% else %}
                <ul class="admin-profile-enrich-country-list">
                    {% for country in overview.synced %}
                        <li>
                            {{ country.name }}
                            <span class="admin-profile-enrich-country-list__meta">({{ country.players_total }} joueurs)</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="ta-card admin-profile-enrich-country-card--pending" aria-labelledby="admin-profile-enrich-pending-title">
            <h2 id="admin-profile-enrich-pending-title" class="admin-profile-enrich-country-card__title admin-profile-enrich-country-card__title--pending">
                Pays à synchroniser ({{ overview.pending|length }})
            </h2>
            <p class="ta-card-text">Au moins un joueur avec prénom abrégé ou manquant.</p>
            {% if overview.pending is empty %}
                <p class="ta-card-text">Aucun pays restant à enrichir.</p>
            {% else %}
                <ul class="admin-profile-enrich-country-list">
                    {% for country in overview.pending %}
                        <li>
                            {{ country.name }}
                            <span class="admin-profile-enrich-country-list__meta">
                                ({{ country.players_to_enrich }}/{{ country.players_total }} à enrichir)
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    {% if status.active and (status.countries_done_names is not empty or status.countries_pending_names is not empty) %}
        <details class="ta-card admin-profile-enrich-details">
            <summary>Détail du parcours séquentiel</summary>
            <div class="admin-profile-enrich-details__grid">
                <div>
                    <p class="ta-card-text"><strong>Déjà passés ({{ status.countries_done_names|length }})</strong></p>
                    <p class="ta-card-text">{{ status.countries_done_names|join(', ') ?: '—' }}</p>
                </div>
                <div>
                    <p class="ta-card-text"><strong>Restants ({{ status.countries_pending_names|length }})</strong></p>
                    <p class="ta-card-text">{{ status.countries_pending_names|join(', ') ?: '—' }}</p>
                </div>
            </div>
        </details>
    {% endif %}

    <section class="ta-card">
        <h2 class="ta-card-title">Actions</h2>
        <div class="admin-profile-enrich-actions">
            {% if not status.completed %}
                <form method="post" action="{{ path('admin_wc2026_sync_players_profile_enrich_run') }}" class="admin-profile-enrich-actions">
                    <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_profile_enrich') }}">
                    <label>
                        Pays par lot
                        <select name="countries_per_batch">
                            {% for n in 1..5 %}
                                <option value="{{ n }}"{% if n == default_batch_size %} selected{% endif %}>{{ n }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary">
                        {% if status.active and status.countries_done > 0 %}
                            Lot suivant
                        {% else %}
                            Démarrer (1<sup>er</sup> lot)
                        {% endif %}
                    </button>
                </form>
            {% else %}
                <p class="ta-card-text">Parcours terminé. Réinitialisez pour recommencer.</p>
            {% endif %}

            <form method="post" action="{{ path('admin_wc2026_sync_players_profile_enrich_reset') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_profile_enrich_reset') }}">
                <button type="submit" class="btn btn-outline">Réinitialiser le parcours</button>
            </form>
        </div>
    </section>
{% endblock %}
