{% extends 'base.html.twig' %}

{% block title %}Enrichissement profils joueurs · LPF 2026{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <h1 class="text-xl font-semibold text-gray-800 dark:text-white/90 mb-2">Enrichissement profils joueurs</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
            Complète les <strong>prénoms</strong> (et noms) via l’API <code>/players?id=</code>, pays par pays
            ({{ batch_size }} pays par lot, {{ max_calls_per_batch }} appels API max par requête).
            Les joueurs déjà enrichis sont ignorés automatiquement.
        </p>

        {% set progress_pct = status.countries_total > 0 ? ((status.countries_done / status.countries_total) * 100)|round : 0 %}

        <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 mb-6 space-y-3">
            <div class="flex justify-between text-sm">
                <span class="text-gray-600 dark:text-gray-400">Progression pays</span>
                <span class="font-medium text-gray-800 dark:text-white/90">
                    {{ status.countries_done }} / {{ status.countries_total }}
                    {% if status.completed %}(terminé){% endif %}
                </span>
            </div>
            <div class="h-2 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
                <div class="h-full bg-brand-500 transition-all" style="width: {{ progress_pct }}%"></div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">
                Cumul : {{ status.totals.updated }} mis à jour,
                {{ status.totals.skipped }} ignorés,
                {{ status.totals.errors }} erreurs,
                {{ status.totals.api_calls }} appels API.
            </p>
            {% if status.next_country_names is not empty and not status.completed %}
                <p class="text-sm text-gray-600 dark:text-gray-300">
                    Prochain lot : {{ status.next_country_names|join(', ') }}
                </p>
            {% endif %}
        </div>

        <div class="flex flex-wrap items-center gap-3">
            {% if not status.completed %}
                <form method="post" action="{{ path('admin_wc2026_sync_players_profile_enrich_run') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_profile_enrich') }}">
                    <button type="submit" class="bg-brand-500 shadow-theme-xs hover:bg-brand-600 inline-flex items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-white transition">
                        {% if status.active and status.countries_done > 0 %}
                            Lot suivant ({{ batch_size }} pays)
                        {% else %}
                            Démarrer (1<sup>er</sup> lot)
                        {% endif %}
                    </button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('admin_wc2026_sync_players_profile_enrich_reset') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_profile_enrich_reset') }}">
                <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-gray-300 dark:border-gray-600 px-4 py-3 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    Réinitialiser
                </button>
            </form>

            <a href="{{ path('admin') }}" class="text-sm text-gray-600 hover:text-brand-500 dark:text-gray-400">Retour admin</a>
        </div>
    </div>
{% endblock %}
