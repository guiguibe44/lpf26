{% extends 'base.html.twig' %}

{% block title %}Sync joueurs (tous) par lots · LPF 2026{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <h1 class="text-xl font-semibold text-gray-800 dark:text-white/90 mb-2">Sync joueurs (tous) — par lots</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
            Importe les sélections compétition pays par pays ({{ batch_size }} équipes par lot).
            Relancez «&nbsp;Lot suivant&nbsp;» jusqu’à la fin pour éviter les timeouts.
        </p>

        {% set progress_pct = status.teams_total > 0 ? ((status.teams_done / status.teams_total) * 100)|round : 0 %}

        <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 mb-6 space-y-3">
            <div class="flex justify-between text-sm">
                <span class="text-gray-600 dark:text-gray-400">Progression</span>
                <span class="font-medium text-gray-800 dark:text-white/90">
                    {{ status.teams_done }} / {{ status.teams_total }} équipes
                    {% if status.completed %}(terminé){% endif %}
                </span>
            </div>
            <div class="h-2 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
                <div class="h-full bg-brand-500 transition-all" style="width: {{ progress_pct }}%"></div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">
                Cumul : +{{ status.totals.created }} créés,
                {{ status.totals.updated }} mis à jour,
                {{ status.totals.skipped }} ignorés.
            </p>
            {% if status.next_team_names is not empty and not status.completed %}
                <p class="text-sm text-gray-600 dark:text-gray-300">
                    Prochain lot : {{ status.next_team_names|join(', ') }}
                </p>
            {% endif %}
        </div>

        <div class="flex flex-wrap items-center gap-3">
            {% if not status.completed %}
                <form method="post" action="{{ path('admin_wc2026_sync_players_batch_run') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_batch') }}">
                    <button type="submit" class="bg-brand-500 shadow-theme-xs hover:bg-brand-600 inline-flex items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-white transition">
                        {% if status.active and status.teams_done > 0 %}
                            Lot suivant ({{ batch_size }} équipes)
                        {% else %}
                            Démarrer (1<sup>er</sup> lot)
                        {% endif %}
                    </button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('admin_wc2026_sync_players_batch_reset') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sync_wc2026_players_batch_reset') }}">
                <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-gray-300 dark:border-gray-600 px-4 py-3 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    Réinitialiser
                </button>
            </form>

            <a href="{{ path('admin') }}" class="text-sm text-gray-600 hover:text-brand-500 dark:text-gray-400">Retour admin</a>
        </div>
    </div>
{% endblock %}
