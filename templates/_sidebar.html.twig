{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<aside class="ta-sidebar">
    <div class="ta-sidebar-brand">
        <a href="{{ path('app_homepage') }}" class="ta-sidebar-logo-link" title="Accueil LPF'26">
            <img
                src="{{ asset('images/ChatGPT Image 14 mai 2026, 19_50_28.png') }}"
                alt="LPF'26"
                class="ta-sidebar-logo"
                loading="lazy"
                decoding="async"
            >
        </a>
    </div>

    <ul class="menu w-full p-0">
        <li>
            <a href="{{ path('app_homepage') }}" class="ta-menu-link {{ currentRoute == 'app_homepage' ? 'active' : '' }}">
                Dashboard
            </a>
        </li>
        <li>
            <a href="{{ path('app_matches') }}" class="ta-menu-link {{ currentRoute in ['app_matches', 'app_pronostics'] ? 'active' : '' }}">
                Matchs
            </a>
        </li>
        <li>
            <a href="{{ path('app_groups') }}" class="ta-menu-link {{ currentRoute == 'app_groups' ? 'active' : '' }}">
                Groupes des pays
            </a>
        </li>
        <li>
            <a href="{{ path('app_ranking') }}" class="ta-menu-link {{ currentRoute == 'app_ranking' ? 'active' : '' }}">
                Classement
            </a>
        </li>

        <li>
            <a href="{{ path('app_account') }}" class="ta-menu-link {{ currentRoute == 'app_account' ? 'active' : '' }}">
                Compte et équipe
            </a>
        </li>
        {% if is_granted('ROLE_ADMIN') %}
        <li>
            <a href="{{ path('admin') }}" class="ta-menu-link {{ currentRoute starts with 'admin' ? 'active' : '' }}">
                Administration
            </a>
        </li>
        {% endif %}
        <li>
            <a href="{{ path('app_logout') }}" class="ta-menu-link">
                Deconnexion
            </a>
        </li>
    </ul>
</aside>
