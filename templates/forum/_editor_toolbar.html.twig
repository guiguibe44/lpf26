<div class="forum-editor__toolbar" role="toolbar" aria-label="Mise en forme du message">
    <button type="button" class="forum-editor__btn" title="Gras" data-command="bold" data-action="forum-editor#format">
        <i class="ti ti-bold" aria-hidden="true"></i>
        <span class="sr-only">Gras</span>
    </button>
    <button type="button" class="forum-editor__btn" title="Italique" data-command="italic" data-action="forum-editor#format">
        <i class="ti ti-italic" aria-hidden="true"></i>
        <span class="sr-only">Italique</span>
    </button>
    <button type="button" class="forum-editor__btn" title="Souligné" data-command="underline" data-action="forum-editor#format">
        <i class="ti ti-underline" aria-hidden="true"></i>
        <span class="sr-only">Souligné</span>
    </button>
    <span class="forum-editor__sep" aria-hidden="true"></span>
    <button type="button" class="forum-editor__btn" title="Liste à puces" data-command="insertUnorderedList" data-action="forum-editor#format">
        <i class="ti ti-list" aria-hidden="true"></i>
        <span class="sr-only">Liste à puces</span>
    </button>
    <button type="button" class="forum-editor__btn" title="Liste numérotée" data-command="insertOrderedList" data-action="forum-editor#format">
        <i class="ti ti-list-numbers" aria-hidden="true"></i>
        <span class="sr-only">Liste numérotée</span>
    </button>
    <button type="button" class="forum-editor__btn" title="Citation" data-command="formatBlock" data-value="blockquote" data-action="forum-editor#format">
        <i class="ti ti-blockquote" aria-hidden="true"></i>
        <span class="sr-only">Citation</span>
    </button>
    <span class="forum-editor__sep" aria-hidden="true"></span>
    <button type="button" class="forum-editor__btn" title="Lien" data-action="forum-editor#link">
        <i class="ti ti-link" aria-hidden="true"></i>
        <span class="sr-only">Insérer un lien</span>
    </button>
</div>
