{% extends 'base.html.twig' %}
{% form_theme form 'form/tailadmin_theme.html.twig' %}

{% block title %}Invitation - {{ invitation.team.name }}{% endblock %}

{% block body %}
    <div class="auth-grid ta-auth-grid">
        {% include 'auth/_auth_aside.html.twig' %}
        <div class="ta-auth-form-wrap">
            <h1 class="section-title ta-auth-title">Finaliser ton inscription</h1>
            <p class="ta-auth-lead">
                Tu as été invité à rejoindre l’équipe <strong>{{ invitation.team.name }}</strong> ({{ invitation.invitedEmail }}).
                {% if existing_account|default(false) %}
                    Choisis ton surnom pour rejoindre l’équipe (tu es déjà connecté).
                {% else %}
                    Choisis un surnom visible par ton partenaire et un mot de passe pour accéder à ton compte.
                {% endif %}
            </p>

            <div class="ta-auth-separator">{% if existing_account|default(false) %}Rejoindre l’équipe{% else %}Compte joueur 2{% endif %}</div>

            {% if form.vars.submitted and form.vars.errors|length > 0 %}
                <div class="flash flash-danger mb-4" role="alert" data-lpf-alert-dismiss="persist">
                    <p class="m-0 font-semibold">Merci de corriger les erreurs ci-dessous :</p>
                    <ul class="ta-form-errors ta-form-errors--alert mt-2 mb-0">
                        {% for error in form.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'class': 'ta-auth-form'}}) }}
                {{ form_row(form.nickname, {'label': 'Surnom*'}) }}
                {{ form_row(form.plainPassword, {'label': 'Mot de passe*'}) }}
                <button type="submit" class="ta-auth-submit">
                    {% if existing_account|default(false) %}Rejoindre l’équipe{% else %}Valider mon inscription{% endif %}
                    <i class="ti ti-check" aria-hidden="true"></i>
                </button>
                {% if not existing_account|default(false) %}
                <p class="ta-auth-link-row">Déjà un compte ? <a href="{{ path('app_login', {_target_path: app.request.requestUri}) }}">Se connecter</a></p>
                {% endif %}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
