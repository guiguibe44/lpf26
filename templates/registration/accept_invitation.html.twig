{% extends 'base.html.twig' %}
{% form_theme form 'form/tailadmin_theme.html.twig' %}

{% block title %}Invitation - {{ invitation.team.name }}{% endblock %}

{% block body %}
    <div class="auth-grid ta-auth-grid">
        <div class="auth-aside ta-auth-aside">
            {% include 'auth/_aside_brand.html.twig' %}
        </div>
        <div class="ta-auth-form-wrap">
            <h1 class="section-title ta-auth-title">Finaliser ton inscription</h1>
            <p class="ta-auth-lead">Tu as ete invite a rejoindre l'equipe <strong>{{ invitation.team.name }}</strong> ({{ invitation.invitedEmail }}). Choisis un surnom visible par ton partenaire et un mot de passe pour acceder a ton compte.</p>

            <div class="ta-auth-separator">Compte joueur 2</div>

            {% if form.vars.submitted and form.vars.errors|length > 0 %}
                <div class="flash flash-danger mb-4" role="alert">
                    <p class="m-0 font-semibold">Merci de corriger les erreurs ci-dessous :</p>
                    <ul class="ta-form-errors ta-form-errors--alert mt-2 mb-0">
                        {% for error in form.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'class': 'ta-auth-form'}}) }}
                {{ form_row(form.nickname, {'label': 'Surnom*'}) }}
                {{ form_row(form.plainPassword, {'label': 'Mot de passe*'}) }}
                <button type="submit" class="ta-auth-submit">Valider mon inscription</button>
                <p class="ta-auth-link-row">Deja un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
