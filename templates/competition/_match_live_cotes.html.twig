{# cotes: buildDisplayContext — intégré dans la carte score live #}
<div class="match-live-score-card__cotes" id="match-live-cotes-banner"{% if cotes.pronostics_count == 0 %} hidden{% endif %}>
    {% if cotes.pronostics_count > 0 %}
        {% if cotes.mode|default('one_n_two') == 'one_n_two' and cotes.home is not null %}
            {% include 'competition/_match_cotes_1n2_blocks.html.twig' with {
                home: cotes.home,
                draw: cotes.draw,
                away: cotes.away,
                active_outcome: cotes.for_outcome|default(null),
                id_prefix: 'match-live-cotes',
                variant: 'square',
                show_pronostics_meta: false,
            } only %}
        {% elseif cotes.for_score is not null %}
            <p class="match-live-cotes-inline ta-card-text">
                Cote score <strong id="match-live-cotes-for-score">×{{ cotes.for_score|number_format(2, ',', ' ') }}</strong>
                {% if cotes.min is not null and cotes.max is not null %}
                    <span class="match-live-cotes-inline__range">
                        · min <span id="match-live-cotes-min">×{{ cotes.min|number_format(2, ',', ' ') }}</span>
                        · moy. <span id="match-live-cotes-avg">×{{ cotes.moyenne|number_format(2, ',', ' ') }}</span>
                        · max <span id="match-live-cotes-max">×{{ cotes.max|number_format(2, ',', ' ') }}</span>
                    </span>
                {% endif %}
            </p>
        {% endif %}
    {% endif %}
</div>
