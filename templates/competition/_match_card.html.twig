{# match: GameMatch, pronostic: Pronostic|null, partner_pronostics: list<Pronostic>, now: DateTimeImmutable, prono_access_blocked: bool|false, joker_usage_by_match_id: array, show_joker_ui: bool|false #}
{% set prono_access_blocked = prono_access_blocked ?? false %}
{% set joker_usage_by_match_id = joker_usage_by_match_id ?? {} %}
{% set show_joker_ui = show_joker_ui ?? false %}
{% set match_joker = joker_usage_by_match_id[match.id] ?? null %}
{% set is_finished = match_is_finished(match, now) %}
{% set is_live = match_is_live(match, now) %}
{% set can_edit_before_kickoff = match_can_edit_before_kickoff(match, now) %}
{% set can_pronostic = can_edit_before_kickoff and not prono_access_blocked %}
{% set match_prono_blocked_cotisation = prono_access_blocked and can_edit_before_kickoff %}
{% set can_place_joker = (show_joker_ui|default(false)) and can_edit_before_kickoff %}

<article class="match-card{{ match.isKdoMatch ? ' match-card--kdo' : '' }}" data-match-id="{{ match.id }}">
    <div class="match-card-head">
        {% if match.isKdoMatch %}
            <span class="ta-badge match-card-kdo-badge">KDO</span>
        {% endif %}
        {% if match_joker %}
            {% if can_place_joker %}
                <button
                    type="button"
                    class="match-card-joker-badge"
                    data-joker-badge
                    data-joker-badge-toggle
                    aria-expanded="false"
                    aria-haspopup="true"
                    title="Afficher les actions joker"
                >Joker : {{ match_joker.name }}{% if match_joker.target_team_name|default('') %} → {{ match_joker.target_team_name }}{% endif %}</button>
            {% else %}
                <span class="match-card-joker-badge match-card-joker-badge--static" data-joker-badge>Joker : {{ match_joker.name }}{% if match_joker.target_team_name|default('') %} → {{ match_joker.target_team_name }}{% endif %}</span>
            {% endif %}
        {% endif %}
        {% if is_finished %}
            <span class="ta-badge ta-badge-success">Terminé</span>
        {% elseif is_live %}
            <span class="ta-badge ta-badge-warning">En direct</span>
        {% elseif can_pronostic %}
            <span class="ta-badge ta-badge-warning">À venir</span>
        {% else %}
            <span class="ta-badge">En cours</span>
        {% endif %}
    </div>

    <div class="match-fixture">
        <div class="match-team match-team-home">
            <span>{{ match.paysDomicile ? match.paysDomicile.nom : '-' }}</span>
            {% include 'components/_country_flag_img.html.twig' with { country: match.paysDomicile } only %}
        </div>

        <time class="match-time" datetime="{{ match.dateHeure ? match.dateHeure|date('c') : '' }}">
            {{ match.dateHeure ? match.dateHeure|date('H:i') : '-' }}
        </time>

        <div class="match-team match-team-away">
            {% include 'components/_country_flag_img.html.twig' with { country: match.paysExterieur } only %}
            <span>{{ match.paysExterieur ? match.paysExterieur.nom : '-' }}</span>
        </div>
    </div>

    <p class="match-meta">
        {% set group_letter = match.groupStandingLetter %}
        {% if group_letter %}
            <a href="{{ path('app_groups') }}#groupe-{{ group_letter|lower }}" class="match-group-link">{{ match.phase ?: ('Groupe ' ~ group_letter) }}</a>
        {% else %}
            {{ match.phase ?: 'Phase a definir' }}
        {% endif %}
        {% if match.venueName %}
            <span class="match-venue"> · {{ match.venueName }}</span>
        {% endif %}
        {% if match.coteMoyenne is not null %}
            · Cote {{ match.coteMoyenne|number_format(2, ',', ' ') }}
        {% endif %}
    </p>

    <div class="match-pronostic">
        {% if match_prono_blocked_cotisation %}
            <p class="match-prono-cotisation-msg">Pronostics disponibles après réglage de la cotisation (10&nbsp;€ par joueur).</p>
        {% elseif can_pronostic %}
            <form method="post" action="{{ path('app_match_pronostic_save', { id: match.id }) }}" class="match-pronostic-form">
                <input
                    type="number"
                    name="score_domicile"
                    min="0"
                    value="{{ pronostic ? pronostic.scoreDomicile : prono_default_score_domicile }}"
                    class="ta-form-input match-score-input"
                    required
                >
                <span>-</span>
                <input
                    type="number"
                    name="score_exterieur"
                    min="0"
                    value="{{ pronostic ? pronostic.scoreExterieur : prono_default_score_exterieur }}"
                    class="ta-form-input match-score-input"
                    required
                >
                <button
                    type="submit"
                    class="btn btn-primary match-pronostic-submit"
                    aria-label="{{ pronostic ? 'Modifier le pronostic' : 'Valider le pronostic' }}"
                >
                    <i class="ti {{ pronostic ? 'ti-edit' : 'ti-check' }}" aria-hidden="true"></i>
                </button>
            </form>
        {% elseif is_live %}
            <div class="match-final-score match-final-score--live">
                {{ match.scoreDomicile is not null ? match.scoreDomicile : 0 }} - {{ match.scoreExterieur is not null ? match.scoreExterieur : 0 }}
            </div>
            <a href="{{ path('app_match_live', { id: match.id }) }}" class="match-link match-link--live">
                Suivre en direct
            </a>
        {% elseif is_finished %}
            <div class="match-final-score">
                {{ match.scoreDomicile }} - {{ match.scoreExterieur }}
            </div>
            <a href="{{ path('app_match_pronostics', { id: match.id }) }}" class="match-link">
                Voir tous les pronos
            </a>
        {% elseif pronostic %}
            <span class="match-locked-pronostic">{{ pronostic.scoreDomicile }} - {{ pronostic.scoreExterieur }}</span>
        {% else %}
            <span class="match-locked-pronostic">{{ prono_default_score_domicile }} - {{ prono_default_score_exterieur }}</span>
        {% endif %}
    </div>

    {% if can_place_joker or match_joker %}
        <div
            class="match-joker-actions"
            data-joker-actions
            data-match-id="{{ match.id }}"
            data-match-label="{{ match.paysDomicile ? match.paysDomicile.nom : '?' }} — {{ match.paysExterieur ? match.paysExterieur.nom : '?' }}"
            data-joker-state-url="{{ path('app_match_jokers_state', { id: match.id }) }}"
            data-joker-place-url="{{ path('app_match_joker_place', { id: match.id }) }}"
            data-joker-remove-url="{{ path('app_match_joker_remove', { id: match.id }) }}"
        >
            <button
                type="button"
                class="btn btn-outline btn-primary btn-sm match-joker-btn"
                data-joker-open
                data-joker-open-initial
                {% if match_joker %}hidden{% endif %}
                {% if prono_access_blocked %}disabled title="Réglez la cotisation pour jouer un joker"{% endif %}
            >
                <i class="ti ti-wand" aria-hidden="true"></i>
                Joker
            </button>
            <div class="match-joker-popover" data-joker-popover hidden>
                <button type="button" class="btn btn-outline btn-primary btn-sm match-joker-btn" data-joker-open>
                    <i class="ti ti-wand" aria-hidden="true"></i>
                    Gérer
                </button>
                <button type="button" class="btn btn-outline btn-sm match-joker-remove-btn" data-joker-remove>
                    <i class="ti ti-x" aria-hidden="true"></i>
                    Retirer
                </button>
            </div>
        </div>
    {% endif %}

    <div class="match-partner">
        {% if partner_pronostics is empty %}
            <span class="match-partner-empty">—</span>
        {% else %}
            {% for partner_pronostic in partner_pronostics %}
                {% set partner_user = partner_pronostic.joueur %}
                <div class="match-partner-row" aria-label="Pronostic partenaire {{ partner_pronostic.scoreDomicile }} à {{ partner_pronostic.scoreExterieur }}">
                    <div class="match-partner-avatar-slot" aria-hidden="true">
                        {% if partner_user.avatar %}
                            <img class="match-partner-avatar" src="{{ partner_user.avatar }}" alt="" width="50" height="50" loading="lazy" decoding="async">
                        {% else %}
                            <span class="match-partner-avatar--placeholder">{{ partner_user.email|first|upper }}</span>
                        {% endif %}
                    </div>
                    <span class="match-partner-score">{{ partner_pronostic.scoreDomicile }} - {{ partner_pronostic.scoreExterieur }}</span>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</article>
