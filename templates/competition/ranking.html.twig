{% extends 'base.html.twig' %}

{% block title %}Classement | LPF 2026{% endblock %}

{% block body %}
    <section class="ta-topbar">
        <div>
            <h1 class="ta-page-title">Classement general</h1>
            <p class="ta-page-subtitle">
                Classement des equipes par total de points, scores exacts et resultats.
                {% if ranking_match %}
                    — Maj. après {{ ranking_match.paysDomicile.nom }} - {{ ranking_match.paysExterieur.nom }}
                {% endif %}
            </p>
        </div>
    </section>

    <section class="ta-card ranking-page-card">
        <div class="ta-dashboard-matchdays-head">
            <div>
                <h2 class="ta-card-title">Tableau des equipes</h2>
                {% if ranking_match %}
                    <p class="ta-card-text">
                        Dernier calcul le {{ ranking_match.dateHeure|date('d/m/Y') }}.
                    </p>
                {% elseif teams_preview is not empty %}
                    <p class="ta-card-text">
                        Aucun match n’a encore été noté. Équipes inscrites (ordre alphabétique) — les points apparaîtront après les premiers résultats.
                    </p>
                {% else %}
                    <p class="ta-card-text">
                        Le classement apparaîtra quand les premiers matchs seront notés.
                    </p>
                {% endif %}
            </div>
            <span class="ta-badge ta-badge-success">{{ ranking is not empty ? ranking|length : teams_preview|length }} équipes</span>
        </div>

        {% if ranking is not empty or teams_preview is not empty %}
            {% include 'competition/_ranking_table.html.twig' with {
                ranking_rows: ranking,
                teams_preview: teams_preview,
            } only %}
        {% endif %}
    </section>
{% endblock %}
