<dialog id="match-live-joker-info-dialog" class="match-live-joker-info-dialog" aria-labelledby="match-live-joker-info-title">
    <div class="match-live-joker-info-dialog__panel" tabindex="-1">
        <button type="button" class="match-live-joker-info-dialog__close" data-match-joker-info-close aria-label="Fermer">
            <i class="ti ti-x" aria-hidden="true"></i>
        </button>
        <div class="match-live-joker-info-dialog__body">
            <div class="match-live-joker-info-dialog__visual" data-match-joker-info-visual hidden>
                <img
                    class="match-live-joker-info-dialog__image"
                    data-match-joker-info-image
                    alt=""
                    width="140"
                    height="186"
                    decoding="async"
                >
                <span class="match-live-joker-info-dialog__placeholder" data-match-joker-info-placeholder hidden aria-hidden="true">
                    <i class="ti ti-wand"></i>
                </span>
            </div>
            <div class="match-live-joker-info-dialog__content">
                <h2 id="match-live-joker-info-title" class="match-live-joker-info-dialog__title" data-match-joker-info-title></h2>
                <p class="match-live-joker-info-dialog__context" data-match-joker-info-context hidden></p>
                <p class="match-live-joker-info-dialog__desc ta-card-text" data-match-joker-info-desc hidden></p>
                <div class="match-live-joker-info-dialog__technical" data-match-joker-info-technical-wrap hidden>
                    <p class="match-live-joker-info-dialog__technical-label">Explications techniques</p>
                    <ul class="match-live-joker-info-dialog__technical-list" data-match-joker-info-technical></ul>
                </div>
            </div>
        </div>
    </div>
</dialog>
