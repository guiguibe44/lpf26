{% extends 'base.html.twig' %}

{% block title %}Groupes | LPF 2026{% endblock %}

{% block body %}
    <section class="ta-card p-5 mb-4">
        <p class="ta-card-text mb-2">
            Après la phase de groupes, consultez le
            <a href="{{ path('app_knockout') }}">calendrier des phases finales</a>
            (16es de finale → finale).
        </p>
    </section>
{#
    <section class="ta-card p-5">
        <h1 class="ta-card-title">Groupes des pays</h1>
        <p class="ta-card-text">
            Classements calculés à partir des matchs de phase « Group … » (synchronisation ou import).
            Les colonnes ne comptent que les matchs déjà joués (score renseigné).
        </p>
    </section>
    #}
    <section class="ta-grid mt-5">
        {% if standings_by_group is not empty %}
            <p class="group-standings-legend ta-card-text mb-0">
                <span class="group-standings-legend__item group-standings-legend__item--qualified">Qualifié pour la suite</span>
                <span class="group-standings-legend__item group-standings-legend__item--eliminated">Éliminé</span>
                <span class="group-standings-legend__item">Barré uniquement lorsque chaque équipe de la poule a joué au moins un match.</span>
            </p>
        {% endif %}
        {% if standings_by_group is empty %}
            <article class="ta-card p-5">
                <p class="ta-card-text">
                    Aucun classement disponible : assignez un groupe aux pays (admin) ou synchronisez des matchs
                    de phase « Group A », etc.
                </p>
            </article>
        {% else %}
            {% for letter, rows in standings_by_group %}
                <article id="groupe-{{ letter|lower }}" class="ta-card p-5 group-standings-card" tabindex="-1">
                    <h2 class="ta-card-title mb-3">Groupe {{ letter }}</h2>
                    <div class="ta-table-wrap group-standings-table-wrap">
                        <table class="ta-table group-standings-table">
                            <thead>
                                <tr>
                                    <th class="ta-num">#</th>
                                    <th>Équipe</th>
                                    <th class="ta-num" title="Matchs joués">MJ</th>
                                    <th class="ta-num" title="Victoires">V</th>
                                    <th class="ta-num" title="Nuls">N</th>
                                    <th class="ta-num" title="Défaites">D</th>
                                    <th class="ta-num" title="Buts pour">BP</th>
                                    <th class="ta-num" title="Buts contre">BC</th>
                                    <th class="ta-num" title="Différence de buts">Diff</th>
                                    <th class="ta-num" title="Points">Pts</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                    {% set is_qualified = row.knockout_status in ['qualified_direct', 'qualified_third'] %}
                                    {% set is_eliminated = row.knockout_status == 'eliminated' %}
                                    <tr class="{{ is_eliminated ? 'group-standings-row--eliminated' : '' }}{{ is_qualified ? ' group-standings-row--qualified' : '' }}">
                                        <td class="ta-num">{{ loop.index }}</td>
                                        <td>
                                            <a class="group-standings-team group-standings-team--link" href="{{ path('app_country_players', { id: row.country.id }) }}" title="Voir les joueurs de {{ row.country.nom }}">
                                                <span class="group-country-flag-wrap group-country-flag-wrap--compact">
                                                    {% include 'components/_country_flag_img.html.twig' with { country: row.country } only %}
                                                </span>
                                                <span class="group-standings-name{{ is_eliminated ? ' group-standings-name--barred' : '' }}">
                                                    {{ row.country.nom }}
                                                    {% if is_qualified %}
                                                        <span class="group-standings-qual-mark" title="Qualifié pour les 16es de finale">✓</span>
                                                    {% endif %}
                                                </span>
                                            </a>
                                        </td>
                                        <td class="ta-num">{{ row.joues }}</td>
                                        <td class="ta-num">{{ row.victoires }}</td>
                                        <td class="ta-num">{{ row.nuls }}</td>
                                        <td class="ta-num">{{ row.defaites }}</td>
                                        <td class="ta-num">{{ row.bp }}</td>
                                        <td class="ta-num">{{ row.bc }}</td>
                                        <td class="ta-num">{% if row.diff > 0 %}+{% endif %}{{ row.diff }}</td>
                                        <td class="ta-num"><strong>{{ row.points }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </article>
            {% endfor %}
        {% endif %}
    </section>
{% endblock %}
