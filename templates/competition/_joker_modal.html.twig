<dialog id="joker-match-dialog" class="joker-dialog">
    <div class="joker-dialog-panel">
        <header class="joker-dialog-head">
            <h2 id="joker-dialog-title" class="joker-dialog-title">Jokers</h2>
            <button type="button" class="joker-dialog-close" data-joker-close aria-label="Fermer">
                <i class="ti ti-x" aria-hidden="true"></i>
            </button>
        </header>
        <p class="joker-dialog-match" id="joker-dialog-match-label" hidden></p>
        <p class="joker-dialog-message ta-card-text" id="joker-dialog-message" hidden></p>
        <div class="joker-dialog-active" id="joker-dialog-active" hidden></div>
        <ul class="joker-dialog-list" id="joker-dialog-list"></ul>
        <p class="joker-dialog-loading ta-card-text" id="joker-dialog-loading">Chargement…</p>
    </div>
</dialog>
