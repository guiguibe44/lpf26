{# cotes: overview from MatchCoteService / Espion #}
{% set mode = cotes.mode|default('one_n_two') %}
<p class="match-cotes-overview match-cotes-overview--{{ mode }}">
    {% if cotes.pronostics_count > 0 %}
        {% if mode == 'one_n_two' and cotes.home is not null %}
            <span class="match-cotes-overview__explain">
                Cotes sur le résultat <strong>1 / N / 2</strong>, calculées sur l’ensemble des pronos du match (comme LPF24).
            </span>
            <span class="match-cotes-overview__grid" role="list">
                <span class="match-cotes-overview__item" role="listitem">
                    <span class="match-cotes-overview__issue">1</span>
                    <strong>×{{ cotes.home|number_format(1, ',', ' ') }}</strong>
                </span>
                <span class="match-cotes-overview__item" role="listitem">
                    <span class="match-cotes-overview__issue">N</span>
                    <strong>×{{ cotes.draw|number_format(1, ',', ' ') }}</strong>
                </span>
                <span class="match-cotes-overview__item" role="listitem">
                    <span class="match-cotes-overview__issue">2</span>
                    <strong>×{{ cotes.away|number_format(1, ',', ' ') }}</strong>
                </span>
            </span>
            <span class="match-cotes-overview__meta match-espion-meta">
                ({{ cotes.pronostics_count }} pronostic{{ cotes.pronostics_count > 1 ? 's' : '' }})
            </span>
            <span class="match-cotes-overview__hint match-espion-meta">
                Bon prono ou score exact : cote du <strong>résultat réel</strong> du match.
                Mauvais prono : cote de <strong>votre</strong> issue (1, N ou 2).
            </span>
        {% elseif cotes.moyenne is not null %}
            <span class="match-cotes-overview__explain">
                Cotes par <strong>score exact</strong> (mode LPF26) : plus un score est rare, plus sa cote est haute (max ×5).
            </span>
            <span class="match-espion-cotes">
                Moy. <strong>{{ cotes.moyenne|number_format(2, ',', ' ') }}</strong>
                {% if cotes.min is not null and cotes.max is not null %}
                    · min {{ cotes.min|number_format(2, ',', ' ') }} · max {{ cotes.max|number_format(2, ',', ' ') }}
                {% endif %}
                <span class="match-espion-meta">({{ cotes.pronostics_count }} pronostic{{ cotes.pronostics_count > 1 ? 's' : '' }})</span>
            </span>
        {% endif %}
    {% else %}
        <span class="match-espion-empty">Pas encore assez de pronostics pour estimer les cotes.</span>
    {% endif %}
</p>
