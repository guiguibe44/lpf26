{% extends 'base.html.twig' %}

{% block title %}Match en direct | LPF 2026{% endblock %}

{% block body %}
    <section class="ta-topbar">
        <div>
            <h1 class="ta-page-title">Match en direct</h1>
            <p class="ta-page-subtitle">
                {{ match.paysDomicile.nom }} — {{ match.paysExterieur.nom }},
                {{ match.dateHeure|date('d/m/Y H:i') }}
            </p>
        </div>
        <a href="{{ path('app_matches') }}" class="btn btn-primary btn-sm">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            Retour aux matchs
        </a>
    </section>

    <section class="ta-card match-live-score-card">
        <div class="match-live-score-banner">
            <div class="match-live-score-team">
                {% include 'components/_country_flag_img.html.twig' with { country: match.paysDomicile } only %}
                <span>{{ match.paysDomicile.nom }}</span>
            </div>
            <p class="match-live-score-display" id="match-live-current-score" aria-live="polite">
                <span id="match-live-score-home">{{ live_view.scoreDomicile }}</span>
                <span class="match-live-score-sep">-</span>
                <span id="match-live-score-away">{{ live_view.scoreExterieur }}</span>
            </p>
            <div class="match-live-score-team match-live-score-team--away">
                {% include 'components/_country_flag_img.html.twig' with { country: match.paysExterieur } only %}
                <span>{{ match.paysExterieur.nom }}</span>
            </div>
        </div>
        <p class="ta-card-text match-live-score-hint">
            Score en cours{% if match.statut == 'LIVE' %} · <span class="ta-badge ta-badge-warning">Live</span>{% endif %}
        </p>
    </section>

    {% if match_active_jokers is not empty %}
        <section class="ta-card mt-5 match-live-jokers-card">
            <h2 class="ta-card-title">Jokers en jeu</h2>
            <div class="overflow-x-auto">
                <table class="table ta-table table-sm match-live-compact-table">
                    <thead>
                        <tr>
                            <th>Équipe</th>
                            <th>Joker</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in match_active_jokers %}
                            <tr>
                                <td>
                                    <div class="match-live-compact-team-cell">
                                        {% if row.team_logo %}
                                            <img src="{{ asset(row.team_logo) }}" alt="" class="match-live-jokers-team-logo" width="24" height="24" loading="lazy">
                                        {% else %}
                                            <span class="match-live-jokers-team-placeholder" aria-hidden="true">{{ row.team_name|first|upper }}</span>
                                        {% endif %}
                                        <span>{{ row.team_name }}</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="match-live-jokers-joker-cell">
                                        {% if row.joker.image %}
                                            <img src="{{ asset(row.joker.image) }}" alt="" class="match-live-jokers-icon" width="22" height="22" loading="lazy">
                                        {% endif %}
                                        <span class="ta-badge match-live-jokers-badge">{{ row.joker.name }}</span>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    <section class="ta-card mt-5 match-live-simulator-card">
        <h2 class="ta-card-title">Simulateur de score</h2>
        <p class="ta-card-text">Ajustez le score pour estimer les points de chaque pronostic (cotes incluses).</p>
        <form class="match-live-simulator-form" id="match-live-simulator" action="#" method="get">
            <label class="match-live-simulator-field">
                <span>{{ match.paysDomicile.nom }}</span>
                <input type="number" name="domicile" min="0" max="30" value="{{ live_view.scoreDomicile }}" class="ta-form-input match-live-score-input" id="sim-score-home" required>
            </label>
            <span class="match-live-simulator-sep">-</span>
            <label class="match-live-simulator-field">
                <span>{{ match.paysExterieur.nom }}</span>
                <input type="number" name="exterieur" min="0" max="30" value="{{ live_view.scoreExterieur }}" class="ta-form-input match-live-score-input" id="sim-score-away" required>
            </label>
            <button type="button" class="btn btn-primary btn-sm" id="match-live-reset-score" title="Revenir au score en cours">
                Score actuel
            </button>
        </form>
    </section>

    <section class="ta-card mt-5 match-live-teams-section">
        <h2 class="ta-card-title">Pronostics par équipe</h2>
        {% if match_cotes_visible(match) %}
            {% include 'competition/_match_live_cotes.html.twig' with { cotes: live_view.cotes } only %}
        {% endif %}
        <p class="ta-card-text mb-3">
            <span class="match-live-legend">Place</span> = classement simulé (<span class="match-live-legend">n</span> = rang avant le match).
            <span class="match-live-legend">Total</span> = points généraux simulés.
            <span class="match-live-legend">Match</span> = pronos + buteurs sur ce match.
            Prono 1 / 2 : score simulé · points.
        </p>
        {% include 'competition/_match_live_teams.html.twig' with {
            teams: live_view.teams,
            cotes_visible: match_cotes_visible(match),
        } only %}
    </section>

    {% if match.isKdoMatch and live_view.kdoOutlook %}
        {% include 'competition/_match_live_kdo.html.twig' with { kdo_outlook: live_view.kdoOutlook } only %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/match-live.js') }}" defer></script>
    <script>
        window.matchLiveConfig = {
            simulateUrl: {{ simulate_url|json_encode|raw }},
            defaultHome: {{ match.scoreDomicile ?? 0 }},
            defaultAway: {{ match.scoreExterieur ?? 0 }},
            teamShowUrlBase: {{ path('app_team_show', { id: 0 })|replace({'/0': '/'})|json_encode|raw }},
            cotesVisible: {{ match_cotes_visible(match) ? 'true' : 'false' }}
        };
    </script>
{% endblock %}
