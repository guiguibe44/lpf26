{# @var teams \App\Dto\MatchLiveTeamRow[] #}
{# cotes_visible: bool — défaut true (page live = match démarré) #}
{% set cotes_visible = cotes_visible|default(true) %}
<div class="match-live-teams-wrap overflow-x-auto" id="match-live-teams" data-cotes-visible="{{ cotes_visible ? '1' : '0' }}">
    <table class="table ta-table table-sm match-live-compact-table">
        <thead>
            <tr>
                <th class="ta-num match-live-compact-th-rank" title="Classement simulé après ce score">Place</th>
                <th class="match-live-compact-th-team">Équipe</th>
                <th class="ta-num" title="Total général simulé (classement + points de ce match)">Total</th>
                <th class="ta-num" title="Points pronos + buteurs sur ce match">Match</th>
                <th class="ta-num match-live-compact-th-prono">Prono 1</th>
                <th class="ta-num match-live-compact-th-prono">Prono 2</th>
                <th class="ta-num" title="Points buteurs marqueurs sur ce match">Buteurs</th>
                <th class="match-live-compact-th-toggle" aria-label="Détail"></th>
            </tr>
        </thead>
        {% for team in teams %}
            {% set detail_id = 'match-live-detail-' ~ team.teamId %}
            {% set prono1 = team.pronostics[0]|default(null) %}
            {% set prono2 = team.pronostics[1]|default(null) %}
            <tbody data-team-id="{{ team.teamId }}">
                <tr class="match-live-row">
                    <td class="match-live-compact-rank ta-num">
                        <span class="match-live-team-position match-live-team-position--simulated" data-simulated-position>#{{ team.simulatedRankingPosition }}</span>
                        {% if team.rankingPosition < 9999 %}
                            <span class="match-live-team-position match-live-team-position--before" title="Rang avant ce match">({{ team.rankingPosition }})</span>
                        {% endif %}
                    </td>
                    <td class="match-live-compact-team">
                        <div class="match-live-compact-team-cell">
                            {% if team.teamLogo %}
                                <img src="{{ asset(team.teamLogo) }}" alt="" class="match-live-team-logo" width="28" height="28" loading="lazy">
                            {% else %}
                                <span class="match-live-team-logo-placeholder" aria-hidden="true">{{ team.teamName|first|upper }}</span>
                            {% endif %}
                            <a href="{{ path('app_team_show', { id: team.teamId }) }}" class="match-live-team-name">{{ team.teamName }}</a>
                        </div>
                    </td>
                    <td class="ta-num match-live-compact-pts" data-team-total-general title="Total général simulé">{{ team.simulatedTotalPoints|number_format(0, ',', ' ') }}</td>
                    <td class="ta-num match-live-compact-pts match-live-compact-pts--match" data-team-match-total title="Points sur ce match">{{ team.matchPointsTotal|number_format(0, ',', ' ') }}</td>
                    <td class="ta-num match-live-compact-prono-cell">
                        {% if prono1 %}
                            <span class="match-live-prono-cell" data-pronostic-id="{{ prono1.pronosticId }}">
                                <span data-prono-score-value>{{ prono1.predHome }}-{{ prono1.predAway }}</span><span class="match-live-prono-cell__sep">·</span><strong data-prono-points>{{ prono1.teamPoints|number_format(0, ',', ' ') }}</strong>
                            </span>
                        {% else %}
                            <span class="match-live-prono-empty">—</span>
                        {% endif %}
                    </td>
                    <td class="ta-num match-live-compact-prono-cell">
                        {% if prono2 %}
                            <span class="match-live-prono-cell" data-pronostic-id="{{ prono2.pronosticId }}">
                                <span data-prono-score-value>{{ prono2.predHome }}-{{ prono2.predAway }}</span><span class="match-live-prono-cell__sep">·</span><strong data-prono-points>{{ prono2.teamPoints|number_format(0, ',', ' ') }}</strong>
                            </span>
                        {% else %}
                            <span class="match-live-prono-empty">—</span>
                        {% endif %}
                    </td>
                    <td class="ta-num match-live-compact-pts" data-team-buteur-points title="Points buteurs sur ce match">{{ team.buteurMatchPoints|number_format(0, ',', ' ') }}</td>
                    <td class="match-live-compact-toggle ta-num">
                        <button
                            type="button"
                            class="btn btn-primary btn-sm match-live-expand-btn"
                            data-match-live-expand
                            aria-expanded="false"
                            aria-controls="{{ detail_id }}"
                            title="Afficher le détail"
                        >
                            <i class="ti ti-chevron-down match-live-expand-btn__icon" aria-hidden="true"></i>
                            <span class="sr-only">Détail {{ team.teamName }}</span>
                        </button>
                    </td>
                </tr>
                <tr class="match-live-detail-row" id="{{ detail_id }}" data-match-live-detail hidden>
                    <td colspan="8" class="match-live-detail-row__cell">
                        <div class="match-live-detail-panel">
                            <p class="match-live-detail-meta mb-2">
                                <span class="match-live-team-joker ta-badge" data-team-joker{% if not team.activeJoker %} hidden{% endif %}>
                                    {%- if team.activeJoker -%}
                                        Joker : {{ team.activeJoker.name }}{% if team.activeJoker.target_team_name|default('') %} → {{ team.activeJoker.target_team_name }}{% endif %}
                                    {%- endif -%}
                                </span>
                                <span class="match-live-detail-meta__sep" data-team-joker{% if not team.activeJoker %} hidden{% endif %}> · </span>
                                Pronos sur ce match : <strong data-team-prono-points>{{ team.pronosticMatchPoints|number_format(0, ',', ' ') }}</strong> pts
                            </p>
                            {% if team.pronostics is not empty %}
                                <ul class="match-live-pronos-detail-list">
                                    {% for prono in team.pronostics %}
                                        <li class="match-live-prono-detail" data-pronostic-id="{{ prono.pronosticId }}">
                                            <span class="match-live-prono-detail__player">{{ prono.playerLabel }}</span>
                                            <span class="match-live-prono-detail__score ta-num" data-prono-score>
                                                <span data-prono-score-value>{{ prono.predHome }}-{{ prono.predAway }}</span>
                                                {%- if prono.scoreInverted|default(false) -%}
                                                    <span class="match-live-prono-invert ta-badge" title="Score inversé par joker">↔</span>
                                                {%- endif -%}
                                            </span>
                                            <span class="match-live-prono-detail__calc ta-num" data-prono-meta>
                                                <span data-prono-base>{{ prono.basePoints }}</span>
                                                {% if cotes_visible %}
                                                    <span class="match-live-prono-cote-sep" data-prono-cote-sep>×</span>
                                                    <span data-prono-cote>{{ prono.coefficient|number_format(2, ',', ' ') }}</span>
                                                {% else %}
                                                    <span data-prono-cote-sep hidden>×</span>
                                                    <span data-prono-cote hidden></span>
                                                {% endif %}
                                            </span>
                                            <span class="match-live-prono-detail__pts ta-num">
                                                <span class="match-live-prono-points ta-badge ta-badge-success" data-prono-points>{{ prono.teamPoints|number_format(0, ',', ' ') }}</span>
                                            </span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {% if team.buteurs is not empty %}
                                <div class="match-live-buteurs-picks">
                                    <span class="match-live-buteurs-picks__label">Buteurs</span>
                                    <div class="match-live-buteurs-picks__list">
                                        {% for buteur in team.buteurs %}
                                            <span class="match-live-buteur-pick">
                                                {% if buteur.photo %}
                                                    <img
                                                        class="match-live-buteur-pick__photo"
                                                        src="{{ buteur.photo starts with 'http' ? buteur.photo : asset(buteur.photo) }}"
                                                        alt=""
                                                        width="32"
                                                        height="32"
                                                        loading="lazy"
                                                        decoding="async"
                                                    >
                                                {% else %}
                                                    <span class="match-live-buteur-pick__photo match-live-buteur-pick__photo--placeholder" aria-hidden="true">{{ buteur.name|first|upper }}</span>
                                                {% endif %}
                                                <span class="match-live-buteur-pick__name">{{ buteur.name }}</span>
                                            </span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            </tbody>
        {% else %}
            <tbody>
                <tr>
                    <td colspan="8" class="match-live-prono-empty">Aucune équipe enregistrée.</td>
                </tr>
            </tbody>
        {% endfor %}
    </table>
</div>
