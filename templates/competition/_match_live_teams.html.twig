{# @var teams \App\Dto\MatchLiveTeamRow[] #}
{# cotes_visible: bool — défaut true (page live = match démarré) #}
{% set cotes_visible = cotes_visible|default(true) %}
<div class="match-live-teams-wrap overflow-x-auto" id="match-live-teams" data-cotes-visible="{{ cotes_visible ? '1' : '0' }}">
    <table class="table ta-table table-sm match-live-compact-table">
        <thead>
            <tr>
                <th class="ta-num match-live-compact-th-rank">#</th>
                <th class="match-live-compact-th-team">Équipe</th>
                <th class="match-live-compact-th-pronos">Pronostics</th>
            </tr>
        </thead>
        {% for team in teams %}
            <tbody data-team-id="{{ team.teamId }}">
                <tr class="match-live-team-summary">
                    <td class="match-live-compact-rank ta-num">
                        <span class="match-live-team-position match-live-team-position--simulated" data-simulated-position title="Classement général simulé">#{{ team.simulatedRankingPosition }}</span>
                        {% if team.rankingPosition < 9999 %}
                            <span class="match-live-team-position match-live-team-position--before" title="Classement avant ce match">({{ team.rankingPosition }})</span>
                        {% endif %}
                    </td>
                    <td class="match-live-compact-team">
                        <div class="match-live-compact-team-cell">
                            {% if team.teamLogo %}
                                <img src="{{ asset(team.teamLogo) }}" alt="" class="match-live-team-logo" width="28" height="28" loading="lazy">
                            {% else %}
                                <span class="match-live-team-logo-placeholder" aria-hidden="true">{{ team.teamName|first|upper }}</span>
                            {% endif %}
                            <div class="match-live-compact-team-meta">
                                <a href="{{ path('app_team_show', { id: team.teamId }) }}" class="match-live-team-name">{{ team.teamName }}</a>
                                <span class="match-live-team-joker ta-badge" data-team-joker{% if not team.activeJoker %} hidden{% endif %} title="Joker actif">
                                    {%- if team.activeJoker -%}
                                        {{ team.activeJoker.name }}{% if team.activeJoker.target_team_name|default('') %} → {{ team.activeJoker.target_team_name }}{% endif %}
                                    {%- endif -%}
                                </span>
                                <div class="match-live-compact-team-pts">
                                    <span class="match-live-team-total" data-team-total title="Points sur ce match">{{ team.matchPoints|number_format(0, ',', ' ') }} pts</span>
                                    <span class="match-live-team-total-general" data-team-total-general title="Total général simulé">{{ team.simulatedTotalPoints|number_format(0, ',', ' ') }} gen.</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="match-live-compact-pronos-cell">
                        {% if team.pronostics is not empty %}
                            <div class="match-live-pronos-summary">
                                {% for prono in team.pronostics %}
                                    <span class="match-live-prono-chip" data-pronostic-id="{{ prono.pronosticId }}">
                                        <span class="match-live-prono-chip__label">{{ prono.playerLabel }}</span>
                                        <span class="match-live-prono-chip__score" data-prono-score><span data-prono-score-value>{{ prono.predHome }}-{{ prono.predAway }}</span></span>
                                        <span class="match-live-prono-chip__pts ta-badge ta-badge-success" data-prono-points>{{ prono.points|number_format(0, ',', ' ') }}</span>
                                    </span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <span class="match-live-prono-empty">Aucun pronostic</span>
                        {% endif %}

                        {% if team.pronostics is not empty or team.buteurs is not empty %}
                            <details class="match-live-team-details">
                                <summary class="match-live-team-details__toggle">Détail</summary>
                                <div class="match-live-team-details__panel">
                                    {% if team.pronostics is not empty %}
                                        <ul class="match-live-pronos-detail-list">
                                            {% for prono in team.pronostics %}
                                                <li class="match-live-prono-detail" data-pronostic-id="{{ prono.pronosticId }}">
                                                    <span class="match-live-prono-detail__player">{{ prono.playerLabel }}</span>
                                                    <span class="match-live-prono-detail__score ta-num" data-prono-score>
                                                        <span data-prono-score-value>{{ prono.predHome }}-{{ prono.predAway }}</span>
                                                        {%- if prono.scoreInverted|default(false) -%}
                                                            <span class="match-live-prono-invert ta-badge" title="Score inversé par joker">↔</span>
                                                        {%- endif -%}
                                                    </span>
                                                    <span class="match-live-prono-detail__calc ta-num" data-prono-meta>
                                                        <span data-prono-base>{{ prono.basePoints }}</span>
                                                        {% if cotes_visible %}
                                                            <span class="match-live-prono-cote-sep" data-prono-cote-sep>×</span>
                                                            <span data-prono-cote>{{ prono.coefficient|number_format(2, ',', ' ') }}</span>
                                                        {% else %}
                                                            <span data-prono-cote-sep hidden>×</span>
                                                            <span data-prono-cote hidden></span>
                                                        {% endif %}
                                                    </span>
                                                    <span class="match-live-prono-detail__pts ta-num">
                                                        <span class="match-live-prono-points ta-badge ta-badge-success" data-prono-points>{{ prono.points|number_format(0, ',', ' ') }}</span>
                                                    </span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    {% if team.buteurs is not empty %}
                                        <div class="match-live-buteurs-picks">
                                            <span class="match-live-buteurs-picks__label">Buteurs</span>
                                            <div class="match-live-buteurs-picks__list">
                                                {% for buteur in team.buteurs %}
                                                    <span class="match-live-buteur-pick">
                                                        {% if buteur.photo %}
                                                            <img
                                                                class="match-live-buteur-pick__photo"
                                                                src="{{ buteur.photo starts with 'http' ? buteur.photo : asset(buteur.photo) }}"
                                                                alt=""
                                                                width="32"
                                                                height="32"
                                                                loading="lazy"
                                                                decoding="async"
                                                            >
                                                        {% else %}
                                                            <span class="match-live-buteur-pick__photo match-live-buteur-pick__photo--placeholder" aria-hidden="true">{{ buteur.name|first|upper }}</span>
                                                        {% endif %}
                                                        <span class="match-live-buteur-pick__name">{{ buteur.name }}</span>
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </details>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        {% else %}
            <tbody>
                <tr>
                    <td colspan="3" class="match-live-prono-empty">Aucune équipe enregistrée.</td>
                </tr>
            </tbody>
        {% endfor %}
    </table>
</div>
