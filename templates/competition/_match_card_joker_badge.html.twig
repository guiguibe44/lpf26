{# joker: array, removable: bool — vignette coin bas-droit de la carte match #}
{% set joker_badge_title = 'Joker : ' ~ joker.name %}
{% if joker.target_team_name|default('') %}
    {% set joker_badge_title = joker_badge_title ~ ' → ' ~ joker.target_team_name %}
{% endif %}
{% if joker.effect_blocked|default(false) %}
    {% set joker_badge_title = joker_badge_title ~ ' (sans effet)' %}
{% endif %}
{% set joker_badge_hint = removable ? joker_badge_title ~ ' — Cliquer pour retirer le joker' : joker_badge_title %}

<div class="match-card-joker-mark">
    {% if removable %}
        <button
            type="button"
            class="match-card-joker-badge match-card-joker-badge--removable"
            data-joker-badge
            data-joker-badge-remove
            title="{{ joker_badge_hint }}"
            aria-label="{{ joker_badge_hint }}"
        >
            <span class="match-card-joker-badge__icon" aria-hidden="true">
                {% if joker.image %}
                    <img
                        src="{{ asset(joker.image) }}"
                        alt=""
                        width="56"
                        height="72"
                        loading="lazy"
                        decoding="async"
                    >
                {% else %}
                    <i class="ti ti-wand"></i>
                {% endif %}
            </span>
            <span class="sr-only">{{ joker_badge_title }} — Retirer</span>
        </button>
    {% else %}
        <span
            class="match-card-joker-badge match-card-joker-badge--static"
            data-joker-badge
            title="{{ joker_badge_title }}"
        >
            <span class="match-card-joker-badge__icon" aria-hidden="true">
                {% if joker.image %}
                    <img
                        src="{{ asset(joker.image) }}"
                        alt=""
                        width="56"
                        height="72"
                        loading="lazy"
                        decoding="async"
                    >
                {% else %}
                    <i class="ti ti-wand"></i>
                {% endif %}
            </span>
            <span class="sr-only">{{ joker_badge_title }}</span>
        </span>
    {% endif %}
</div>
