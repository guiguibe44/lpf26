{# espion_intel — bouton œil à la place du joker, contenu dans <template> pour la popup #}
<div class="match-joker-espion-slot" data-match-espion>
    <button
        type="button"
        class="btn match-joker-btn match-joker-btn--discrete match-joker-btn--espion"
        data-espion-open
        aria-haspopup="dialog"
        aria-controls="match-espion-intel-dialog"
        title="Renseignements espion — voir le détail"
        aria-label="Renseignements espion"
    >
        <i class="ti ti-eye" aria-hidden="true"></i>
        <span class="sr-only">Renseignements espion</span>
    </button>
    <template data-espion-intel-template>
        {% include 'competition/_match_espion_intel_content.html.twig' with { espion_intel: espion_intel } only %}
    </template>
</div>
