{# Clair : logo couleur — Sombre : logo blanc (html.dark, hors EasyAdmin) #}
{% set use_front_logo = front_logo|default(false) %}
{% set logo_light_png = use_front_logo ? 'images/lpf-front-logo.png' : 'images/lpf26-logo-color.png' %}
{% set logo_light_webp = use_front_logo ? 'images/lpf-front-logo.webp' : null %}
{% set logo_dark_png = 'images/lpf26-logo-white.png' %}
{% set logo_width = width|default(use_front_logo ? 320 : null) %}
{% set logo_height = height|default(use_front_logo ? 213 : null) %}
<span class="lpf-brand-logo-wrap {{ wrap_class|default('') }}">
    {% if logo_light_webp %}
        <picture class="lpf-brand-logo lpf-brand-logo--classic-light">
            <source srcset="{{ asset(logo_light_webp) }}" type="image/webp">
            <img
                src="{{ asset(logo_light_png) }}"
                alt="LPF'26"
                class="{{ img_class|default('') }}"
                {% if logo_width %}width="{{ logo_width }}"{% endif %}
                {% if logo_height %}height="{{ logo_height }}"{% endif %}
                loading="{{ loading|default('eager') }}"
                decoding="async"
            >
        </picture>
    {% else %}
        <img
            src="{{ asset(logo_light_png) }}"
            alt="LPF'26"
            class="lpf-brand-logo lpf-brand-logo--classic-light {{ img_class|default('') }}"
            {% if logo_width %}width="{{ logo_width }}"{% endif %}
            {% if logo_height %}height="{{ logo_height }}"{% endif %}
            loading="{{ loading|default('lazy') }}"
            decoding="async"
        >
    {% endif %}
    <img
        src="{{ asset(logo_dark_png) }}"
        alt="LPF'26"
        class="lpf-brand-logo lpf-brand-logo--classic-dark {{ img_class|default('') }}"
        {% if logo_width %}width="{{ logo_width }}"{% endif %}
        {% if logo_height %}height="{{ logo_height }}"{% endif %}
        loading="{{ loading|default('eager') }}"
        decoding="async"
    >
</span>
