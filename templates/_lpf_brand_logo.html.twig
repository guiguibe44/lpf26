{# Thème clair uniquement (logo couleur) #}
<span class="lpf-brand-logo-wrap {{ wrap_class|default('') }}">
    <img
        src="{{ asset('images/lpf26-logo-color.png') }}"
        alt="LPF'26"
        class="lpf-brand-logo {{ img_class|default('') }}"
        {% if width is defined %}width="{{ width }}"{% endif %}
        {% if height is defined %}height="{{ height }}"{% endif %}
        loading="{{ loading|default('lazy') }}"
        decoding="async"
    >
</span>
