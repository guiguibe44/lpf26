{# Thèmes : par défaut (clair) | sombre | GTA #}
{% set switcher_id = switcher_id|default('lpf-theme-switcher-label') %}
{% set select_id = select_id|default(switcher_id ~ '-select') %}
{% set show_legend = show_legend|default(modifier|default('') != 'sidebar') %}
<div class="lpf-theme-switcher{% if modifier is defined and modifier %} lpf-theme-switcher--{{ modifier }}{% endif %}" data-lpf-theme-switcher>
    {% if show_legend %}
        <label class="lpf-theme-switcher__legend" id="{{ switcher_id }}" for="{{ select_id }}">Thème</label>
    {% endif %}
    <select
        id="{{ select_id }}"
        class="lpf-theme-switcher__select"
        data-lpf-theme-select
        {% if show_legend %}aria-labelledby="{{ switcher_id }}"{% else %}aria-label="Thème du site"{% endif %}
        title="Choisir le thème"
    >
        <option value="classic-light">Par défaut</option>
        <option value="classic">Sombre</option>
        <option value="gta">GTA</option>
    </select>
</div>
