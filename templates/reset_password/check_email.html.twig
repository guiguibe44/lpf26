{% extends 'base.html.twig' %}

{% block title %}Email envoye{% endblock %}

{% block body %}
    <div class="auth-grid ta-auth-grid">
        <div class="auth-aside ta-auth-aside">
            <a href="{{ path('app_login') }}" class="ta-auth-back">Retour a la connexion</a>
            <div class="auth-brand ta-auth-brand">LPF 2026</div>
            <h2 class="ta-auth-aside-title">Email envoye</h2>
            <p class="auth-subtitle">Verification de ton adresse en cours.</p>
        </div>
        <div class="ta-auth-form-wrap">
            <h1 class="section-title ta-auth-title">Consulte ta boite mail</h1>
            <p class="ta-auth-lead">Si un compte existe, un email vient d'etre envoye avec un lien de reinitialisation.</p>
            <p class="ta-auth-lead">Le lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
            <p class="ta-auth-link-row">Rien recu ? Verifie les spams ou <a href="{{ path('app_forgot_password_request') }}">reessaye</a>.</p>
            <p class="ta-auth-link-row"><a href="{{ path('app_login') }}">Retour a la connexion</a></p>
        </div>
    </div>
{% endblock %}
