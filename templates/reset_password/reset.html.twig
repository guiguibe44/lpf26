{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <div class="auth-grid ta-auth-grid">
        <div class="auth-aside ta-auth-aside">
            {% include 'auth/_aside_brand.html.twig' %}
        </div>
        <div class="ta-auth-form-wrap">
            <h1 class="section-title ta-auth-title">Mise a jour du mot de passe</h1>
            {{ form_start(resetForm, {'attr': {'class': 'ta-auth-form'}}) }}
                {{ form_row(resetForm.plainPassword, {'label': 'Nouveau mot de passe*'}) }}
                <button class="ta-auth-submit">Mettre a jour le mot de passe</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
