<dialog
    id="lpf-image-lightbox"
    class="lpf-image-lightbox"
    aria-labelledby="lpf-image-lightbox-caption"
>
    <div class="lpf-image-lightbox__panel" role="document">
        <button
            type="button"
            class="lpf-image-lightbox__close"
            data-lpf-lightbox-close
            aria-label="Fermer"
        >
            <i class="ti ti-x" aria-hidden="true"></i>
        </button>
        <figure class="lpf-image-lightbox__figure">
            <img
                src=""
                alt=""
                class="lpf-image-lightbox__image"
                data-lpf-lightbox-image
                decoding="async"
            >
            <figcaption
                id="lpf-image-lightbox-caption"
                class="lpf-image-lightbox__caption"
                data-lpf-lightbox-caption
            ></figcaption>
        </figure>
    </div>
</dialog>
