{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
        {% include 'home/_admin_site_guide.html.twig' %}
    {% endif %}

    {% if competition_started and buteur_stats %}
        {% include 'buteur/_stats_summary.html.twig' with { buteur_stats: buteur_stats } only %}
    {% endif %}

    {% if not competition_started %}
        {% include 'home/_dashboard_buteur.html.twig' with {
            cotisation_payee: cotisation_payee,
            dashboard_partners: dashboard_partners,
            buteurs_pris_par_autres_equipes: buteurs_pris_par_autres_equipes,
            buteur_stats: buteur_stats,
        } only %}
    {% endif %}

    <section class="match-dashboard-wrap mt-5 {{ prono_access_blocked ? 'match-dashboard-wrap--locked' : '' }}">
        {% if live_matches is empty and last_completed_matchday is null and next_matchday is null %}
            <p class="ta-card-text mt-3">Aucun match à afficher pour le moment.</p>
        {% else %}
            {% if live_matches is not empty %}
                <div class="match-day-section match-day-section--live">
                    <h2 class="match-day-title">Match{{ live_matches|length > 1 ? 's' : '' }} en direct</h2>
                    <div class="match-card-grid">
                        {% for match in live_matches %}
                            {% include 'competition/_match_card.html.twig' with {
                                match: match,
                                pronostic: pronostics_by_match_id[match.id] ?? null,
                                partner_pronostics: partner_pronostics_by_match_id[match.id] ?? [],
                                now: now,
                                prono_access_blocked: prono_access_blocked,
                                joker_usage_by_match_id: joker_usage_by_match_id,
                                show_joker_ui: show_joker_ui|default(false)
                            } only %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if last_completed_matchday %}
                <div class="match-day-section">
                    <h2 class="match-day-title">Dernière journée  — {{ last_completed_matchday.date|fr_date_long }}</h2>
                    <div class="match-card-grid">
                        {% for match in last_completed_matchday.matches %}
                            {% include 'competition/_match_card.html.twig' with {
                                match: match,
                                pronostic: pronostics_by_match_id[match.id] ?? null,
                                partner_pronostics: partner_pronostics_by_match_id[match.id] ?? [],
                                now: now,
                                prono_access_blocked: prono_access_blocked,
                                joker_usage_by_match_id: joker_usage_by_match_id,
                                show_joker_ui: show_joker_ui|default(false)
                            } only %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if next_matchday %}
                <div class="match-day-section {{ live_matches is not empty or last_completed_matchday ? 'mt-6' : '' }}">
                    <h2 class="match-day-title">Prochaine journée — {{ next_matchday.date|fr_date_long }}</h2>
                    <div class="match-card-grid">
                        {% for match in next_matchday.matches %}
                            {% include 'competition/_match_card.html.twig' with {
                                match: match,
                                pronostic: pronostics_by_match_id[match.id] ?? null,
                                partner_pronostics: partner_pronostics_by_match_id[match.id] ?? [],
                                now: now,
                                prono_access_blocked: prono_access_blocked,
                                joker_usage_by_match_id: joker_usage_by_match_id,
                                show_joker_ui: show_joker_ui|default(false)
                            } only %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </section>

    {% if app.user %}
        {% include 'competition/_joker_modal.html.twig' %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.user %}
        <script src="{{ asset('js/joker-match.js') }}?v=4" defer></script>
    {% endif %}
{% endblock %}
