{% if recap.recap_gif_url %}
<p style="margin:0 0 12px;text-align:center;">
    <img src="{{ recap.recap_gif_url }}" alt="" width="280" style="display:block;max-width:100%;height:auto;margin:0 auto;border-radius:10px;">
</p>
{% endif %}

<p style="margin:0 0 10px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    Bonjour <strong>{{ nickname }}</strong>,
</p>

<p style="margin:0 0 12px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    {{ recap.intro_line|raw }}
</p>

<p style="margin:0 0 8px;font-size:13px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;">
    Période · {{ recap.period_label }}
</p>
<p style="margin:0 0 10px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    Équipe <strong>{{ recap.team_name }}</strong> :
    {% if recap.total_team_points > 0 %}
        <strong style="color:#16a34a;">+{{ recap.total_team_points|number_format(0, ',', ' ') }} pts</strong>
    {% else %}
        <strong style="color:#6b7280;">{{ recap.total_team_points|number_format(0, ',', ' ') }} pt</strong>
    {% endif %}
    sur {{ recap.matches_count }} match{{ recap.matches_count > 1 ? 's' : '' }}.
    {% if recap.player_comparison %}
        {{ recap.player_comparison.leader_nickname }} mène avec <strong>{{ recap.player_comparison.leader_points }} pts</strong>,
        devant {{ recap.player_comparison.trailer_nickname }} à <strong>{{ recap.player_comparison.trailer_points }} pts</strong>
        (écart : {{ recap.player_comparison.gap_points }} pt{{ recap.player_comparison.gap_points > 1 ? 's' : '' }}).
    {% endif %}
</p>

<p style="margin:0 0 10px;font-size:13px;line-height:1.4;color:#b45309;">
    <strong>{{ bigballs_term('name') }}</strong> = les 2 joueurs posent exactement le même prono sur un match.
    {% if recap.bigballs_summary.attempted > 0 %}
        Sur la période : {{ recap.bigballs_summary.succeeded }} réussi{{ recap.bigballs_summary.succeeded > 1 ? 's' : '' }}
        / {{ recap.bigballs_summary.attempted }} tenté{{ recap.bigballs_summary.attempted > 1 ? 's' : '' }}.
    {% else %}
        Aucun {{ bigballs_term('name') }} tenté sur cette période.
    {% endif %}
</p>

<p style="margin:0 0 10px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    <strong>Buteurs :</strong>
    {% if recap.goals is not empty %}
        {% for goal in recap.goals %}
            {{ goal.nickname }} ({{ goal.buteur }}) sur {{ goal.match }}{% if goal.minute %} à la {{ goal.minute }}'{% endif %} (+{{ goal.points }} pts){% if not loop.last %} ; {% else %}.{% endif %}
        {% endfor %}
    {% else %}
        pas de points buteur sur cette période.
    {% endif %}
</p>

<p style="margin:0 0 10px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    <strong>Jokers :</strong>
    {% if recap.jokers_placed is empty and recap.jokers_suffered is empty %}
        aucun joker joué ou subi.
    {% else %}
        {% if recap.jokers_placed is not empty %}
            posés — {% for j in recap.jokers_placed %}{{ j.name }} ({{ j.match }}){% if not loop.last %}, {% else %}{% endif %}{% endfor %}
        {% endif %}
        {% if recap.jokers_suffered is not empty %}
            {% if recap.jokers_placed is not empty %} ; {% endif %}
            subis — {% for j in recap.jokers_suffered %}{{ j.name }} ({{ j.match }}){% if j.blocked %}, neutralisé{% endif %}{% if not loop.last %}, {% else %}{% endif %}{% endfor %}
        {% endif %}.
    {% endif %}
</p>

<p style="margin:0 0 12px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    <strong>Classement :</strong>
    {% if recap.ranking %}
        {% if recap.ranking.before %}
            {{ recap.ranking.before.position }}<sup>e</sup> → {{ recap.ranking.after.position }}<sup>e</sup> / {{ recap.ranking.after.teams_count }},
            total {{ recap.ranking.after.total|number_format(0, ',', ' ') }} pts.
        {% else %}
            position actuelle {{ recap.ranking.after.position }}<sup>e</sup> / {{ recap.ranking.after.teams_count }},
            total {{ recap.ranking.after.total|number_format(0, ',', ' ') }} pts.
        {% endif %}
        {% if recap.ranking_cheer %} {{ recap.ranking_cheer|raw }}{% endif %}
    {% else %}
        pas de variation disponible sur la période.
    {% endif %}
</p>
{% include 'email/content/_cta_button.html.twig' with {
    actionUrl: teamShowUrl,
    ctaLabel: 'Voir la fiche de mon équipe',
} only %}

<p style="margin:10px 0 0;font-size:14px;line-height:1.4;">
    <a href="{{ rankingUrl }}" style="color:#1b2d4f;">Classement complet</a>
</p>

<p style="margin:14px 0 0;font-size:12px;line-height:1.4;color:#9ca3af;">
    Pas envie de ce récap ? <a href="{{ accountNotificationsUrl }}" style="color:#6b7280;">Désactiver dans mes notifications</a>.
</p>
