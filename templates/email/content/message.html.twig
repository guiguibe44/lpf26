<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#2a2a2a;">
    Bonjour{% if greetingName is defined and greetingName %} {{ greetingName }}{% endif %},
</p>
{% if title is defined and title %}
    <h1 style="margin:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:22px;font-weight:700;line-height:1.3;color:#1b2d4f;">
        {{ title }}
    </h1>
{% endif %}
<div style="margin:0;font-size:16px;line-height:1.65;color:#2a2a2a;">
    {{ body|nl2br }}
</div>
{% if actionUrl is defined and actionUrl and ctaLabel is defined and ctaLabel %}
    {% include 'email/content/_cta_button.html.twig' %}
{% endif %}
