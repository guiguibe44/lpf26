<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#2a2a2a;">Bonjour,</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.65;color:#2a2a2a;">
    {% if registrationKind == 'partner' %}
        Un joueur vient de finaliser son inscription via une <strong>invitation</strong>.
    {% else %}
        Une nouvelle <strong>inscription</strong> vient d'être enregistrée sur le site.
    {% endif %}
</p>
<table style="width:100%;border-collapse:collapse;margin:0 0 20px;font-size:15px;line-height:1.5;color:#2a2a2a;">
    <tr>
        <td style="padding:8px 12px;background:#f1f5f9;font-weight:600;width:40%;">Équipe</td>
        <td style="padding:8px 12px;background:#f8fafc;">{{ team.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px;background:#f1f5f9;font-weight:600;">E-mail joueur</td>
        <td style="padding:8px 12px;background:#f8fafc;">{{ userEmail }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px;background:#f1f5f9;font-weight:600;">Surnom</td>
        <td style="padding:8px 12px;background:#f8fafc;">{{ member.nickname }}</td>
    </tr>
    {% if invitedPartnerEmail %}
        <tr>
            <td style="padding:8px 12px;background:#f1f5f9;font-weight:600;">Partenaire invité</td>
            <td style="padding:8px 12px;background:#f8fafc;">{{ invitedPartnerEmail }}</td>
        </tr>
    {% endif %}
</table>
{% include 'email/content/_cta_button.html.twig' with {
    actionUrl: absolute_url(path('admin_team_index')),
    ctaLabel: 'Voir les équipes (admin)',
} only %}
