{# Layout e-mail LPF'26 : fond blanc, bordure bleue, logo centré en en-tête #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{ pageTitle|default('LPF\'26') }}</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#eef1f6;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#eef1f6;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                {# Cadre principal : bordure bleue, fond blanc #}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:600px;border-collapse:separate;border:3px solid #1b2d4f;border-radius:12px;background-color:#ffffff;">
                    {# En-tête : logo centré sur fond blanc #}
                    <tr>
                        <td align="center" style="padding:28px 28px 16px;background-color:#ffffff;border-radius:9px 9px 0 0;">
                            {% if logoUrl is defined and logoUrl %}
                                <img
                                    src="{{ logoUrl }}"
                                    alt="LPF'26"
                                    width="240"
                                    height="160"
                                    style="display:block;margin:0 auto;border:0;max-width:240px;width:100%;height:auto;"
                                >
                            {% endif %}
                        </td>
                    </tr>
                    {# Séparateur léger sous le header #}
                    <tr>
                        <td style="padding:0 28px;background-color:#ffffff;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="border-top:1px solid #e8e5dd;font-size:0;line-height:0;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:14px 28px 0;background-color:#ffffff;">
                            <p style="margin:0;font-size:20px;line-height:1.3;font-weight:700;color:#1b2d4f;">
                                {{ pageTitle|default('LPF\'26') }}
                            </p>
                        </td>
                    </tr>
                    {# Contenu #}
                    <tr>
                        <td style="padding:16px 28px 24px;background-color:#ffffff;font-size:15px;line-height:1.55;color:#2a2a2a;">
                            {{ content|raw }}
                        </td>
                    </tr>
                    {# Pied de page #}
                    <tr>
                        <td align="center" style="padding:18px 28px 26px;background-color:#ffffff;border-top:1px solid #e8e5dd;border-radius:0 0 9px 9px;">
                            <p style="margin:0 0 4px;font-size:12px;line-height:1.5;color:#6b7280;">
                                Lotopotofoot — LPF'26
                            </p>
                            <p style="margin:0;font-size:11px;line-height:1.5;color:#9ca3af;">
                                {{ footerNote|default('') }}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
