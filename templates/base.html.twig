<!DOCTYPE html>
{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set isAuthPage = currentRoute in ['app_login', 'app_register', 'app_forgot_password_request', 'app_check_email', 'app_reset_password', 'app_team_invitation_accept'] %}
{% set isAppShellPage = (not isAuthPage) %}
{% set show_cotisation_banner = isAppShellPage and app.user and not app.user.cotisationPayee %}
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <meta name="theme-color" content="#1B2D4F">
        <title>{% block title %}LPF 2026{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon-lpf/favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon-lpf/favicon-32x32.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/favicon-lpf/apple-touch-icon.png') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        {% if isAppShellPage %}
            <link rel="stylesheet" href="{{ asset('tailadmin-dashboard.css') }}?v=admin-site-guide">
        {% endif %}
        {% if isAuthPage %}
            <link rel="stylesheet" href="{{ asset('front-dashboard.css') }}?v=lpf-auth-red">
        {% endif %}
        {# Option typographie / boutons / menu : supprimer ce lien (+ fichier public/theme-typography-ui.css) pour revenir au style par défaut #}
        <link rel="stylesheet" href="{{ asset('theme-typography-ui.css') }}?v=2">
        <link rel="stylesheet" href="{{ asset('lpf26-theme.css') }}?v=8">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="front-body{{ isAuthPage ? ' front-body--auth' : '' }}{{ show_cotisation_banner ? ' front-body--cotisation-banner' : '' }}">
        {% if isAuthPage %}
            <main class="auth-wrap">
                <section class="auth-card">
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="flash {{ label == 'success' ? 'flash-success' : (label == 'danger' ? 'flash-danger' : 'flash-info') }}">
                                    <span>{{ message }}</span>
                                </div>
                            {% endfor %}
                        {% endfor %}
                        {{ block('body') }}
                </section>
            </main>
        {% else %}
            {% if show_cotisation_banner %}
                {% include '_cotisation_banner.html.twig' %}
            {% endif %}
            <div class="ta-shell" data-controller="mobile-nav">
                <header class="ta-mobile-bar">
                    <a href="{{ path('app_homepage') }}" class="ta-mobile-bar__logo-link" title="Accueil LPF'26">
                        <img
                            src="{{ asset('images/ChatGPT Image 14 mai 2026, 19_50_28.png') }}"
                            alt="LPF'26"
                            class="ta-mobile-bar__logo"
                            loading="lazy"
                            decoding="async"
                        >
                    </a>
                    <button
                        type="button"
                        class="ta-burger lpf-burger"
                        aria-label="Ouvrir le menu"
                        aria-expanded="false"
                        aria-controls="ta-sidebar"
                        data-action="click->mobile-nav#toggle"
                    >
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__ball" aria-hidden="true"></span>
                    </button>
                </header>
                <button
                    type="button"
                    class="ta-sidebar-backdrop"
                    aria-label="Fermer le menu"
                    tabindex="-1"
                    data-mobile-nav-target="backdrop"
                    data-action="click->mobile-nav#close"
                ></button>
                <div class="ta-sidebar-wrap" data-action="click->mobile-nav#closeOnNavigate">
                    {% include '_sidebar.html.twig' %}
                </div>
                <main class="ta-main">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash {{ label == 'success' ? 'flash-success' : (label == 'danger' ? 'flash-danger' : 'flash-info') }}">
                                <span>{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {{ block('body') }}
                </main>
            </div>
        {% endif %}
    </body>
</html>
