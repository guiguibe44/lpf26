<!DOCTYPE html>
{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set isAuthPage = currentRoute in ['app_login', 'app_register', 'app_forgot_password_request', 'app_check_email', 'app_reset_password', 'app_team_invitation_accept'] %}
{% set isAppShellPage = (not isAuthPage) %}
{% set show_cotisation_banner = isAppShellPage and app.user and not app.user.cotisationPayee %}
<html lang="fr" class="lpf-classic-light">
    <head>
        <script>
            (function () {
                try {
                    localStorage.setItem('lpfTheme', 'classic-light');
                    localStorage.setItem('lpfGtaTheme', '0');
                } catch (e) {
                    /* ignore */
                }
                var html = document.documentElement;
                html.classList.remove('dark', 'lpf-gta-theme', 'lpf-gta-miami');
                html.classList.add('lpf-classic-light');
            })();
        </script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <meta name="theme-color" content="#f8fafc">
        <title>{% block title %}LPF 2026{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon-lpf/favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon-lpf/favicon-32x32.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/favicon-lpf/apple-touch-icon.png') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
        {% if not isAuthPage %}
            <link rel="stylesheet" href="{{ asset('tailadmin-dashboard.css') }}?v=lpf-prono-layout">
            <link rel="stylesheet" href="{{ asset('css/mobile-front.css') }}?v=9">
        {% endif %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% if not isAuthPage %}
                {{ importmap('app') }}
            {% endif %}
        {% endblock %}

        {% if isAuthPage %}
            <link rel="stylesheet" href="{{ asset('lpf-auth-layout.css') }}?v=1">
            {# Auth : chargé en dernier (bat anciennes surcharges claires) #}
            <link rel="stylesheet" href="{{ asset('lpf-auth-dark.css') }}?v=4">
        {% else %}
            {# Shell connecté : même principe qu’auth, après tailadmin + importmap #}
            <link rel="stylesheet" href="{{ asset('lpf-app-dark.css') }}?v=6">
        {% endif %}
        <link rel="stylesheet" href="{{ asset('lpf-classic-light.css') }}?v=7">
        <link rel="stylesheet" href="{{ asset('lpf-classic-light-front.css') }}?v=6">
        <link rel="stylesheet" href="{{ asset('gta-premium-theme.css') }}?v=1">
        <link rel="stylesheet" href="{{ asset('gta-miami-theme.css') }}?v=1">
        {# Typo + boutons GTA — actifs uniquement avec html.lpf-gta-theme #}
        <link rel="stylesheet" href="{{ asset('lpf-gta-typography.css') }}?v=2">
        <link rel="stylesheet" href="{{ asset('lpf-gta-buttons.css') }}?v=3">
        {% if not isAuthPage %}
            <link rel="stylesheet" href="{{ asset('css/joker-match-drawer.css') }}?v=6">
            <link rel="stylesheet" href="{{ asset('css/forum.css') }}?v=3">
            <link rel="stylesheet" href="{{ asset('css/forum-panel.css') }}?v=3">
        {% endif %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="front-body{{ isAuthPage ? ' front-body--auth' : '' }}{{ show_cotisation_banner ? ' front-body--cotisation-banner' : '' }}">
        {% if isAuthPage %}
            <main class="auth-wrap">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash {{ label == 'success' ? 'flash-success' : (label == 'danger' ? 'flash-danger' : 'flash-info') }}">
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}
                {{ block('body') }}
            </main>
        {% else %}
            {% if show_cotisation_banner %}
                {% include '_cotisation_banner.html.twig' %}
            {% endif %}
            <div class="ta-shell" data-controller="mobile-nav">
                <header class="ta-mobile-bar">
                    <a href="{{ path('app_homepage') }}" class="ta-mobile-bar__logo-link" title="Accueil LPF'26">
                        {% include '_lpf_brand_logo.html.twig' with { img_class: 'ta-mobile-bar__logo' } %}
                    </a>
                    <button
                        type="button"
                        class="ta-burger lpf-burger"
                        aria-label="Ouvrir le menu"
                        aria-expanded="false"
                        aria-controls="ta-sidebar"
                        data-action="click->mobile-nav#toggle"
                    >
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__line" aria-hidden="true"></span>
                        <span class="lpf-burger__ball" aria-hidden="true"></span>
                    </button>
                </header>
                <button
                    type="button"
                    class="ta-sidebar-backdrop"
                    aria-label="Fermer le menu"
                    tabindex="-1"
                    data-mobile-nav-target="backdrop"
                    data-action="click->mobile-nav#close"
                ></button>
                <div class="ta-sidebar-wrap" data-action="click->mobile-nav#closeOnNavigate">
                    {% include '_sidebar.html.twig' %}
                </div>
                <main class="ta-main">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash {{ label == 'success' ? 'flash-success' : (label == 'danger' ? 'flash-danger' : 'flash-info') }}">
                                <span>{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {{ block('body') }}
                </main>
                {% if app.user %}
                    {% include 'forum/_shell.html.twig' %}
                {% endif %}
            </div>
        {% endif %}
        <script src="{{ asset('js/lpf-theme-light.js') }}?v=1"></script>
    </body>
</html>
