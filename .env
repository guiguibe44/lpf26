# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Dev : aucun envoi réel
MAILER_DSN=null://null
# Expéditeur par défaut (en-tête From) pour tous les e-mails transactionnels
MAILER_FROM="LPF'26 <no-reply@lotopotofoot.fr>"
#
# Prod sans SMTP : utiliser le transport personnalisé qui appelle la fonction PHP mail()
# (souvent OK sur OVH mutualisé là où sendmail en mode Symfony / proc_open échoue) :
#
#   MAILER_DSN="php-mail://default"
#
# Sinon, SMTP OVH (ne pas utiliser native://default ni sendmail://default seuls — erreur ProcessStream exit -1) :
#   MAILER_DSN="smtp://ADRESSE_EMAIL_COMPLETE:MOT_DE_PASSE@ssl0.ovh.net:465?encryption=ssl"
#
###< symfony/mailer ###

###> app/competition ###
# Date/heure de debut competition (1er match), format ex: 2026-06-11 20:00:00
COMPETITION_START_AT=
###< app/competition ###

###> app/cotisation ###
# Numero affiche dans la popup « cotisation / virement » (ex. +33612345678). Laisser vide pour masquer la ligne.
COTISATION_WIRE_PHONE=
###< app/cotisation ###

###> app/api-football (API-Sports v3) ###
# Clé du tableau de bord https://dashboard.api-sports.io/ — à mettre de préférence dans .env.local
# CDM : https://www.api-football.com/news/post/fifa-world-cup-2026-guide-to-using-data-with-api-sports
# Ligue 1 = Coupe du monde. Saison 2026 = CDM 2026 (souvent réservé aux plans payants).
# Offre gratuite : saisons 2022–2024 souvent seules — test synchro : API_FOOTBALL_WC_SEASON=2022 dans .env.local. Plan payant : 2026 (CDM 2026).
API_FOOTBALL_KEY=
API_FOOTBALL_WC_LEAGUE_ID=1
API_FOOTBALL_WC_SEASON=2026
# Délai entre deux appels /players (ms). Gratuit : 4000–8000. Payant (~7500/j) : 0–500 dans .env.local pour aller plus vite.
API_FOOTBALL_REQUEST_DELAY_MS=4000
# Plafond requêtes HTTP pour une synchro joueurs admin / défaut CLI (1× /teams + N× /players). Payant : 500–2000 selon besoin.
API_FOOTBALL_SYNC_MAX_REQUESTS=500
# Plafond appels /fixtures/events pour importer les buts (0 = désactiver la synchro buts).
API_FOOTBALL_SYNC_GOALS_MAX_REQUESTS=300
# Synchro automatique pendant les matchs (cron : */3 * * * * php bin/console app:live-match:sync).
API_FOOTBALL_LIVE_SYNC_ENABLED=1
API_FOOTBALL_LIVE_SYNC_LOOKAHEAD_MINUTES=20
API_FOOTBALL_LIVE_SYNC_GRACE_MINUTES=240
###< app/api-football (API-Sports v3) ###
