# Copier ce fichier en .env.deploy (non versionné) et remplir les valeurs.
#
# OVH Web Hosting (Gra) : l’hôte SSH est souvent du type
#   ssh01.cluster130.gra.hosting.ovh.net
# (peut différer du nom « ssh.cluster130.hosting.ovh.net » — utiliser celui qui marche avec ta clé.)
#
# Exemple réel (cluster Gra 130, utilisateur lotopou-26, dossier projet vide prêt pour rsync) :
# DEPLOY_SSH_HOST=ssh01.cluster130.gra.hosting.ovh.net
# DEPLOY_SSH_USER=lotopou-26
# DEPLOY_REMOTE_PATH=/homez.1544/lotopou/lpf26

DEPLOY_SSH_HOST=ssh01.cluster000.gra.hosting.ovh.net
DEPLOY_SSH_USER=votre_utilisateur_ssh
# Chemin ABSOLU du projet (résultat de « pwd » dans le dossier où sera composer.json)
DEPLOY_REMOTE_PATH=/homez.XXXX/votre_login/lpf26

# Optionnel : clé privée si ce n’est pas la clé par défaut (~/.ssh/id_ed25519)
# DEPLOY_SSH_KEY=/Users/moi/.ssh/id_ed25519_ovh

# Mot de passe uniquement (sans clé) : 1 = désactive BatchMode + multiplexage SSH (une saisie / run)
# DEPLOY_SSH_PASSWORD_AUTH=1

# Sur OVH, « php » en SSH est souvent déjà la bonne version (ex. 8.5).
DEPLOY_PHP_BIN=php
DEPLOY_COMPOSER=composer
# OVH sans « composer » dans le PATH : installer composer.phar dans DEPLOY_REMOTE_PATH (voir docs/deployment-ovh.md) puis :
# DEPLOY_COMPOSER="php composer.phar"

# --- E-mail en prod (mot de passe oublié, invitations) ---
# Sur le serveur : .env.local — sans SMTP, utiliser la fonction PHP mail() :
#   MAILER_DSN="php-mail://default"
# Ou SMTP OVH : MAILER_DSN="smtp://..." puis : php bin/console cache:clear --env=prod
