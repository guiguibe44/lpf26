# Valeurs par défaut pour APP_ENV=prod (fichier versionné, sans secrets).
# Sur le serveur : .env.local ou .env.prod.local avec secrets + APP_DEBUG=0.

###> app/match-cotes ###
MATCH_COTE_MODE=one_n_two
###< app/match-cotes ###

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
###< symfony/framework-bundle ###

###> app/badges ###
BADGES_ENABLED=false
BADGES_IRONIC_ENABLED=true
###< app/badges ###
